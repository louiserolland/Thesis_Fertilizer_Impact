# Copy this file to .env and fill in your own keys.
# .env is ignored by Git; this template is tracked so you remember which keys are needed.

FRED_API_KEY=your_fred_key_here
# UN Comtrade: free key, product "comtrade - v1" on https://comtradedeveloper.un.org
COMTRADE_API_KEY=your_comtrade_key_here
# USDA MyMarketNews (Illinois fertilizer prices): free account on https://mymarketnews.ams.usda.gov
AMS_API_KEY=your_ams_key_here
