# .gitattributes — tells Git how to treat files.
# Main job here: line endings. Windows ends lines with CRLF, macOS/Linux with LF.
# Without this file, Git can show every line of a file as "changed" when only the
# line endings changed. With it, Git stores LF in the repository and gives you
# your system's native line endings when you check files out.
* text=auto

# Always LF for code and text files (identical on every computer)
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.ipynb  text eol=lf

# Binary files: never touch them, never try to show a text diff
*.xlsx   binary
*.xls    binary
*.pdf    binary
*.png    binary
*.duckdb binary
